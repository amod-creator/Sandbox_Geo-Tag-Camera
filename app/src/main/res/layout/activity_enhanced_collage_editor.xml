<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    android:fitsSystemWindows="true"
    tools:context=".collage.EnhancedCollageEditorActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/collageToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000"
            app:title="Collage Editor"
            app:titleTextColor="#FFF"
            app:navigationIconTint="#FFF"
            app:menu="@menu/enhanced_collage_menu"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main collage canvas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="200dp"
        android:background="#000"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.amod.geotagcamera.collage.CollageCanvas
            android:id="@+id/collageCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"/>

    </FrameLayout>

    <!-- Floating Action Buttons -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddPhoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:layout_marginTop="80dp"
        android:src="@drawable/ic_add_photo"
        app:backgroundTint="#FF5722"
        app:tint="#FFF"/>

    <!-- Control Panel -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#101010"
        android:elevation="8dp">

        <!-- Tab buttons -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tabRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabLayout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="Layout"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="#FFF"
                app:strokeColor="#FFF"
                app:strokeWidth="1dp"
                app:checkedIconTint="@android:color/white"
                app:backgroundTint="@android:color/transparent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabBorder"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="Border"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="#FFF"
                app:strokeColor="#FFF"
                app:strokeWidth="1dp"
                app:checkedIconTint="@android:color/white"
                app:backgroundTint="@android:color/transparent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabRatio"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="Frame Ratio"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="#FFF"
                app:strokeColor="#FFF"
                app:strokeWidth="1dp"
                app:checkedIconTint="@android:color/white"
                app:backgroundTint="@android:color/transparent"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Options RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/optionsList"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:background="#1A1A1A"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>