<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F3F5">

    <!-- Top AppBar matching the screenshot: "< Template" -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="8dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_dark"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Template"
            android:textColor="#1A1A1A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- Scrollable list of templates -->
    <ScrollView
        android:id="@+id/templateScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp">

            <!-- 2. DateTime Template -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DateTime Template"
                android:textColor="#1F2A38"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemplateDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#595959">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Big DateTime Header with vertical divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09:15 PM"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="26dp"
                            android:background="#FFC107"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20 September 2026"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sunday"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Surat, Gujarat, India \uD83C\uDDEE\uD83C\uDDF3"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4rm3+6m2, Opp. Aakash East Point, Althan, Surat, Gujarat 395007, India"
                        android:textColor="#E0E0E0"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lat 21.132845° Long 72.804873°"
                        android:textColor="#E0E0E0"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Scan Location Template -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan Location Template"
                android:textColor="#E65100"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemplateScanLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#595959">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="6dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_map_thumb"
                        app:shapeAppearanceOverlay="@style/RoundedMapCorners" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Surat, Gujarat, India \uD83C\uDDEE\uD83C\uDDF3"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4rm3+6m2, Opp. Aakash East Point, Althan, Surat, Gujarat 395007, India"
                            android:textColor="#E0E0E0"
                            android:textSize="9.5sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lat 21.132845° Long 72.804873°"
                            android:textColor="#E0E0E0"
                            android:textSize="9.5sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunday, 20/09/2026 09:15 PM"
                            android:textColor="#E0E0E0"
                            android:textSize="9.5sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- QR Code preview container -->
                    <ImageView
                        android:id="@+id/previewQrCode"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="QR Code" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Classic Template -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Classic Template"
                android:textColor="#1F2A38"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemplateClassic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#595959">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="95dp"
                        android:layout_height="95dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_map_thumb"
                        app:shapeAppearanceOverlay="@style/RoundedMapCorners" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Surat, Gujarat, India \uD83C\uDDEE\uD83C\uDDF3"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4rm3+6m2, Opp. Aakash East Point, Althan, Surat, Gujarat 395007, India"
                            android:textColor="#E0E0E0"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lat 21.132845° Long 72.804873°"
                            android:textColor="#E0E0E0"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunday, 20/09/2026 09:15 PM GMT +05:30"
                            android:textColor="#E0E0E0"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Reporting Template -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reporting Template"
                android:textColor="#1F2A38"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemplateReporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#595959">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <!-- Map container with green "Check In" banner -->
                    <LinearLayout
                        android:layout_width="95dp"
                        android:layout_height="95dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:background="@drawable/template_check_in_badge"
                            android:text="Check In"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:scaleType="centerCrop"
                            android:src="@drawable/sample_map_thumb" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Surat, Gujarat, India \uD83C\uDDEE\uD83C\uDDF3"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4rm3+6m2, Opp. Aakash East Point, Althan, Surat, Gujarat 395007, India"
                            android:textColor="#E0E0E0"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lat 21.132845° Long 72.804873°"
                            android:textColor="#E0E0E0"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunday, 20/09/2026 09:15 PM GMT +05:30"
                            android:textColor="#E0E0E0"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Navigation Compass Template -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Navigation Compass Template"
                android:textColor="#1F2A38"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemplateCompass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#595959">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="6dp"
                    android:gravity="center_vertical">

                    <!-- Compass Dial -->
                    <ImageView
                        android:id="@+id/previewCompassDial"
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:scaleType="fitCenter" />

                    <!-- Center details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Surat, Gujarat, India \uD83C\uDDEE\uD83C\uDDF3"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4rm3+6m2, Opp. Aakash East Point, Althan, Surat, Gujarat 395007, India"
                            android:textColor="#E0E0E0"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lat 21.132845° Long 72.804873°"
                            android:textColor="#E0E0E0"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunday, 20/09/2026 09:15 PM GMT +05:30"
                            android:textColor="#E0E0E0"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Azimuth/Bearing : 0.00°"
                            android:textColor="#E0E0E0"
                            android:textSize="9sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="1dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⛰️ 15 m"
                                android:textColor="#E0E0E0"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="     \uD83E\uDDF2 71.25 µT"
                                android:textColor="#E0E0E0"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Mini Map Thumbnail (Enlarged to match Compass Dial) -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_map_thumb"
                        app:shapeAppearanceOverlay="@style/RoundedMapCorners" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Location Watermark Template -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location Watermark Template"
                android:textColor="#1F2A38"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemplateLocationWatermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#182029">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_map_thumb"
                        app:shapeAppearanceOverlay="@style/RoundedMapCorners" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 SURAT, GUJARAT, INDIA"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Althan, Surat, Gujarat 395007, India"
                            android:textColor="#E0E0E0"
                            android:textSize="10sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lat 21.132845°   Long 72.804873°"
                            android:textColor="#80D8FF"
                            android:textSize="9.5sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Friday, 25/09/2026 05:45 PM"
                            android:textColor="#B0BEC5"
                            android:textSize="9sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
