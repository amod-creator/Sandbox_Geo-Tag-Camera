<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#000000">

    <!-- Toolbar: ← Back | Actions: Add Text, Undo, Save, Share, Report -->
    <LinearLayout
        android:id="@+id/collageToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A1A1A"
        android:paddingHorizontal="8dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_white"
            app:tint="#FFFFFF"
            android:contentDescription="Back"
            android:layout_gravity="center_vertical" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Collage"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_gravity="center_vertical" />

        <!-- Add Text Button -->
        <LinearLayout
            android:id="@+id/btnAddText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_sticker_edit"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Text"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Undo Button -->
        <LinearLayout
            android:id="@+id/btnUndo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_reset_white"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Undo"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Save Button -->
        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_save_white"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Share Button -->
        <LinearLayout
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_share_white"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Report Button -->
        <LinearLayout
            android:id="@+id/btnReport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_export_white"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Canvas area: shows rendered collage preview -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/collagePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:background="#222222" />

        <!-- Drag overlay for touch events -->
        <View
            android:id="@+id/dragOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- Floating Quick Zoom & Scale Controller for selected image cell -->
        <LinearLayout
            android:id="@+id/cellZoomControlPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/badge_background"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:elevation="10dp"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnCellZoomOut"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/btn_round_black_border"
                android:src="@drawable/ic_zoom_out"
                android:contentDescription="Zoom Out"
                android:padding="7dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/txtCellZoomPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#FFC107"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/btnCellZoomIn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/btn_round_black_border"
                android:src="@drawable/ic_zoom_in"
                android:contentDescription="Zoom In"
                android:padding="7dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#44FFFFFF"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnCellZoomReset"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/btn_round_black_border"
                android:src="@drawable/ic_reset_white"
                android:contentDescription="Reset Scale"
                android:padding="8dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- Progress indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="#FFC107" />

        <!-- Interactive Custom Note / Text Sticker on Collage -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/liveCustomNoteContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <!-- Inner Content Box with selectable bounding box border -->
            <FrameLayout
                android:id="@+id/stickerContentBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:background="@drawable/sticker_border_selected"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/liveCustomNoteText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:text="Site Visit" />
            </FrameLayout>

            <!-- Top-Left: Delete button -->
            <ImageButton
                android:id="@+id/btnStickerDelete"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintTop_toTopOf="@+id/stickerContentBox"
                app:layout_constraintBottom_toTopOf="@+id/stickerContentBox"
                app:layout_constraintStart_toStartOf="@+id/stickerContentBox"
                app:layout_constraintEnd_toStartOf="@+id/stickerContentBox"
                android:background="@drawable/btn_sticker_control_circle"
                android:src="@drawable/ic_sticker_delete"
                android:scaleType="centerInside"
                android:padding="5dp"
                android:elevation="4dp"
                android:contentDescription="Delete Text" />

            <!-- Top-Right: Mirror/Flip button -->
            <ImageButton
                android:id="@+id/btnStickerMirror"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintTop_toTopOf="@+id/stickerContentBox"
                app:layout_constraintBottom_toTopOf="@+id/stickerContentBox"
                app:layout_constraintStart_toEndOf="@+id/stickerContentBox"
                app:layout_constraintEnd_toEndOf="@+id/stickerContentBox"
                android:background="@drawable/btn_sticker_control_circle"
                android:src="@drawable/ic_sticker_mirror"
                android:scaleType="centerInside"
                android:padding="5dp"
                android:elevation="4dp"
                android:contentDescription="Mirror Text" />

            <!-- Bottom-Left: Edit button -->
            <ImageButton
                android:id="@+id/btnStickerEdit"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintTop_toBottomOf="@+id/stickerContentBox"
                app:layout_constraintBottom_toBottomOf="@+id/stickerContentBox"
                app:layout_constraintStart_toStartOf="@+id/stickerContentBox"
                app:layout_constraintEnd_toStartOf="@+id/stickerContentBox"
                android:background="@drawable/btn_sticker_control_circle"
                android:src="@drawable/ic_sticker_edit"
                android:scaleType="centerInside"
                android:padding="5dp"
                android:elevation="4dp"
                android:contentDescription="Edit Text" />

            <!-- Bottom-Right: Resize & Rotate button -->
            <ImageButton
                android:id="@+id/btnStickerResize"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintTop_toBottomOf="@+id/stickerContentBox"
                app:layout_constraintBottom_toBottomOf="@+id/stickerContentBox"
                app:layout_constraintStart_toEndOf="@+id/stickerContentBox"
                app:layout_constraintEnd_toEndOf="@+id/stickerContentBox"
                android:background="@drawable/btn_sticker_control_circle"
                android:src="@drawable/ic_sticker_resize"
                android:scaleType="centerInside"
                android:padding="5dp"
                android:elevation="4dp"
                android:contentDescription="Resize and Rotate Text" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- Bottom Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:elevation="8dp">

        <!-- Tab Bar: Grid | Layout | Border | Background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tabRatio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Ratio"
                android:textColor="#FFC107"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Layout"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tabRotate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Rotate"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tabBorder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Border"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tabBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Background"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Options strip: horizontal scrolling for the selected tab -->
        <HorizontalScrollView
            android:id="@+id/optionsScroll"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>
