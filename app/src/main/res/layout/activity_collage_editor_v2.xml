<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#000000">

    <!-- Toolbar: ← Back | "Collage" | Undo | Save | Share | Report -->
    <LinearLayout
        android:id="@+id/collageToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A1A1A"
        android:paddingHorizontal="8dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_white"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Collage"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_reset_white"
            app:tint="#FFFFFF"
            android:contentDescription="Undo" />

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_save_white"
            app:tint="#FFFFFF"
            android:contentDescription="Save" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share_white"
            app:tint="#FFFFFF"
            android:contentDescription="Share" />

        <ImageButton
            android:id="@+id/btnReport"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_export_white"
            app:tint="#FFFFFF"
            android:contentDescription="Report" />
    </LinearLayout>

    <!-- Canvas area: shows rendered collage preview -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="12dp">

        <ImageView
            android:id="@+id/collagePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:background="#222222" />

        <!-- Drag overlay for touch events -->
        <View
            android:id="@+id/dragOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- Progress indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="#FFC107" />
    </FrameLayout>

    <!-- Bottom Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:elevation="8dp">

        <!-- Tab Bar: Grid | Layout | Border | Background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tabRatio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Ratio"
                android:textColor="#FFC107"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Layout"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tabBorder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Border"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tabBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Background"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Options strip: horizontal scrolling for the selected tab -->
        <HorizontalScrollView
            android:id="@+id/optionsScroll"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>
