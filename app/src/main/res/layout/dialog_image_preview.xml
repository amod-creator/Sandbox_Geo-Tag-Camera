<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/photoCounterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Photos: 0/6" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/previewImageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/deleteImageButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/delete_image" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/thumbnailContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/retakeButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Retake" />

        <Button
            android:id="@+id/addPhotosButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Add\nPhotos" />

        <Button
            android:id="@+id/prepareReportButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Prepare\nReport"
            android:singleLine="false" />
    </LinearLayout>
</LinearLayout>