<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootContainer"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp"
        android:paddingTop="16dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/gallery_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:padding="2dp"
            android:src="@drawable/ic_gallery"
            android:scaleType="centerCrop"
            android:background="#212121"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:strokeWidth="1.5dp"
            app:strokeColor="#FFFFFF"
            app:shapeAppearanceOverlay="@style/CircleShape"
            app:layout_constraintBottom_toBottomOf="@+id/camera_capture_button"
            app:layout_constraintTop_toTopOf="@+id/camera_capture_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/prepare_button"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <ImageButton
            android:id="@+id/prepare_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_prepare_report"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@+id/camera_capture_button"
            app:layout_constraintTop_toTopOf="@+id/camera_capture_button"
            app:layout_constraintStart_toEndOf="@id/gallery_button"
            app:layout_constraintEnd_toStartOf="@id/camera_capture_button" />

        <ImageButton
            android:id="@+id/camera_capture_button"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:src="@drawable/capture_button_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/prepare_button"
            app:layout_constraintEnd_toStartOf="@id/video_record_button" />

        <ImageButton
            android:id="@+id/video_record_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_video_record"
            app:tint="@android:color/white"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@+id/camera_capture_button"
            app:layout_constraintTop_toTopOf="@+id/camera_capture_button"
            app:layout_constraintStart_toEndOf="@id/camera_capture_button"
            app:layout_constraintEnd_toStartOf="@id/collage_button" />

        <ImageButton
            android:id="@+id/collage_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_collage"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@+id/camera_capture_button"
            app:layout_constraintTop_toTopOf="@+id/camera_capture_button"
            app:layout_constraintStart_toEndOf="@id/video_record_button"
            app:layout_constraintEnd_toStartOf="@id/switch_camera_button" />

        <ImageButton
            android:id="@+id/switch_camera_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_camera_switch"
            app:layout_constraintBottom_toBottomOf="@+id/camera_capture_button"
            app:layout_constraintTop_toTopOf="@+id/camera_capture_button"
            app:layout_constraintStart_toEndOf="@id/collage_button"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Zoom Buttons (1x / 2x) positioned above the button bar -->
    <LinearLayout
        android:id="@+id/zoomButtonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/zoomButton06x"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text=".6x"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/zoom_button_inactive_bg"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/zoomButton1x"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="1x"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/zoom_button_active_bg"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/zoomButton2x"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="2x"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/zoom_button_inactive_bg"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/gpsOverlayWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        app:layout_constraintBottom_toTopOf="@+id/zoomButtonContainer"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/badgeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/badge_background">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="2dp"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="App Icon" />

            <TextView
                android:id="@+id/badgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ad Free GPS Cam Visit Pro"
                android:textColor="#FFFFFF"
                android:textSize="7sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/gpsOverlayCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardBackgroundColor="#99000000">

            <LinearLayout
                android:id="@+id/gpsOverlayContent"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="9dp"
                android:gravity="top"
                android:baselineAligned="false">

                <FrameLayout
                    android:id="@+id/liveMapThumbnailContainer"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    android:layout_height="match_parent"
                    android:minHeight="80dp"
                    android:layout_marginTop="2dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/liveMapThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/live_map_thumbnail"
                        app:shapeAppearanceOverlay="@style/RoundedMapCorners"
                        android:clickable="true"
                        android:focusable="true"/>

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/gpsOverlayTextContainer"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1.3"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp">

                    <!-- Bold city/state header with flag -->
                    <TextView
                        style="@style/TextAppearance.App.GpsOverlayTitle"
                        android:id="@+id/geo_city_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:includeFontPadding="false"
                        android:text="Location"/>

                    <!-- Full address details (merged with lat/long and datetime) -->
                    <TextView
                        style="@style/TextAppearance.App.GpsOverlayValue"
                        android:id="@+id/geo_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:includeFontPadding="false"
                        android:maxLines="6"
                        android:lineSpacingExtra="2dp"
                        android:breakStrategy="balanced"
                        android:singleLine="false"
                        android:text="@string/address_placeholder"/>

                    <!-- Lat/Long in one line (hidden, updated programmatically for compatibility) -->
                    <TextView
                        style="@style/TextAppearance.App.GpsOverlayValue"
                        android:id="@+id/geo_latlon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="Lat --°   Long --°"/>

                    <!-- Date/time (hidden, updated programmatically for compatibility) -->
                    <TextView
                        style="@style/TextAppearance.App.GpsOverlayValue"
                        android:id="@+id/geo_datetime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="@string/datetime_format"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_baseline_settings_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>