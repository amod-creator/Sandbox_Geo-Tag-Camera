<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootContainer"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.amod.geotagcamera.ui.CameraGridView
        android:id="@+id/cameraGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp"
        android:paddingTop="16dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/gallery_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:padding="2dp"
            android:src="@drawable/ic_gallery"
            android:scaleType="centerCrop"
            android:background="#212121"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:strokeWidth="2dp"
            app:strokeColor="#000000"
            app:shapeAppearanceOverlay="@style/CircleShape"
            app:layout_constraintBottom_toBottomOf="@+id/camera_capture_button"
            app:layout_constraintTop_toTopOf="@+id/camera_capture_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/prepare_button"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <ImageButton
            android:id="@+id/prepare_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/btn_round_black_border"
            android:src="@drawable/ic_prepare_report"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@+id/camera_capture_button"
            app:layout_constraintTop_toTopOf="@+id/camera_capture_button"
            app:layout_constraintStart_toEndOf="@id/gallery_button"
            app:layout_constraintEnd_toStartOf="@id/camera_capture_button" />

        <ImageButton
            android:id="@+id/camera_capture_button"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:src="@drawable/capture_button_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/prepare_button"
            app:layout_constraintEnd_toStartOf="@id/video_record_button" />

        <ImageButton
            android:id="@+id/video_record_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/btn_round_black_border"
            android:src="@drawable/ic_video_record"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@+id/camera_capture_button"
            app:layout_constraintTop_toTopOf="@+id/camera_capture_button"
            app:layout_constraintStart_toEndOf="@id/camera_capture_button"
            app:layout_constraintEnd_toStartOf="@id/collage_button" />

        <ImageButton
            android:id="@+id/collage_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/btn_round_black_border"
            android:src="@drawable/ic_collage"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@+id/camera_capture_button"
            app:layout_constraintTop_toTopOf="@+id/camera_capture_button"
            app:layout_constraintStart_toEndOf="@id/video_record_button"
            app:layout_constraintEnd_toStartOf="@id/switch_camera_button" />

        <ImageButton
            android:id="@+id/switch_camera_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/btn_round_black_border"
            android:src="@drawable/ic_camera_switch"
            app:layout_constraintBottom_toBottomOf="@+id/camera_capture_button"
            app:layout_constraintTop_toTopOf="@+id/camera_capture_button"
            app:layout_constraintStart_toEndOf="@id/collage_button"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Zoom Buttons (1x / 2x) positioned above the button bar -->
    <LinearLayout
        android:id="@+id/zoomButtonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/zoomButton06x"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text=".6x"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/zoom_button_inactive_bg"
            android:layout_marginEnd="8dp"
            android:visibility="visible"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/zoomButton1x"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="1x"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/zoom_button_active_bg"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/zoomButton2x"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="2x"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/zoom_button_inactive_bg"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Interactive Custom Note / Text Sticker on Live Camera -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/liveCustomNoteContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/gpsOverlayWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp">

        <!-- Inner Content Box with selectable bounding box border -->
        <FrameLayout
            android:id="@+id/stickerContentBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:background="@drawable/sticker_border_selected"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/liveCustomNoteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="Site Visit" />
        </FrameLayout>

        <!-- Top-Left: Delete button (Trash can icon in white circle) -->
        <ImageButton
            android:id="@+id/btnStickerDelete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintTop_toTopOf="@+id/stickerContentBox"
            app:layout_constraintBottom_toTopOf="@+id/stickerContentBox"
            app:layout_constraintStart_toStartOf="@+id/stickerContentBox"
            app:layout_constraintEnd_toStartOf="@+id/stickerContentBox"
            android:background="@drawable/btn_sticker_control_circle"
            android:src="@drawable/ic_sticker_delete"
            android:scaleType="centerInside"
            android:padding="5dp"
            android:elevation="4dp"
            android:contentDescription="Delete Text" />

        <!-- Top-Right: Mirror/Flip button (Mirror icon in white circle) -->
        <ImageButton
            android:id="@+id/btnStickerMirror"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintTop_toTopOf="@+id/stickerContentBox"
            app:layout_constraintBottom_toTopOf="@+id/stickerContentBox"
            app:layout_constraintStart_toEndOf="@+id/stickerContentBox"
            app:layout_constraintEnd_toEndOf="@+id/stickerContentBox"
            android:background="@drawable/btn_sticker_control_circle"
            android:src="@drawable/ic_sticker_mirror"
            android:scaleType="centerInside"
            android:padding="5dp"
            android:elevation="4dp"
            android:contentDescription="Mirror Text" />

        <!-- Bottom-Left: Edit button (Pencil icon in white circle) -->
        <ImageButton
            android:id="@+id/btnStickerEdit"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintTop_toBottomOf="@+id/stickerContentBox"
            app:layout_constraintBottom_toBottomOf="@+id/stickerContentBox"
            app:layout_constraintStart_toStartOf="@+id/stickerContentBox"
            app:layout_constraintEnd_toStartOf="@+id/stickerContentBox"
            android:background="@drawable/btn_sticker_control_circle"
            android:src="@drawable/ic_sticker_edit"
            android:scaleType="centerInside"
            android:padding="5dp"
            android:elevation="4dp"
            android:contentDescription="Edit Text" />

        <!-- Bottom-Right: Resize & Rotate button (Diagonal arrows in white circle) -->
        <ImageButton
            android:id="@+id/btnStickerResize"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintTop_toBottomOf="@+id/stickerContentBox"
            app:layout_constraintBottom_toBottomOf="@+id/stickerContentBox"
            app:layout_constraintStart_toEndOf="@+id/stickerContentBox"
            app:layout_constraintEnd_toEndOf="@+id/stickerContentBox"
            android:background="@drawable/btn_sticker_control_circle"
            android:src="@drawable/ic_sticker_resize"
            android:scaleType="centerInside"
            android:padding="5dp"
            android:elevation="4dp"
            android:contentDescription="Resize and Rotate Text" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/gpsOverlayWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        app:layout_constraintBottom_toTopOf="@id/zoomButtonContainer"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Separate Badge Overlay on top-right, outside of the GPS Overlay Card -->
        <LinearLayout
            android:id="@+id/badgeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="2dp"
            android:background="@drawable/badge_background">

            <ImageView
                android:id="@+id/badgeAppThumbnail"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="5dp"
                android:src="@mipmap/ic_launcher_round"
                android:scaleType="fitCenter"
                android:contentDescription="App Thumbnail" />

            <TextView
                android:id="@+id/badgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ads Free GPS Cam Visit Pro"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/gpsOverlayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardBackgroundColor="#CC101418">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <!-- DateTime Template Header (visible only for DateTime Template) -->
                <LinearLayout
                    android:id="@+id/liveDateTimeHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/liveBigTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="09:15 PM"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="22dp"
                        android:background="#FFC107"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/liveDateLine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20 September 2026"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/liveDayLine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunday"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/gpsOverlayContent"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <!-- Compass Dial (visible only for Navigation Compass Template) -->
                    <ImageView
                        android:id="@+id/liveCompassDial"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="6dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="Compass Dial" />

                    <!-- Map Thumbnail Card (Pristine 80dp Square with 8dp rounded corners) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/liveMapThumbnailCard"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#212121">

                        <FrameLayout
                            android:id="@+id/liveMapThumbnailContainer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/liveMapThumbnail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/live_map_thumbnail"
                                android:clickable="true"
                                android:focusable="true"/>

                            <!-- Google watermark at bottom-left of map thumbnail -->
                            <TextView
                                android:id="@+id/liveGoogleWatermark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="3dp"
                                android:text="Google"
                                android:textColor="#FFFFFF"
                                android:textSize="8.5sp"
                                android:textStyle="bold"
                                android:shadowColor="#E6000000"
                                android:shadowDx="1.5"
                                android:shadowDy="1.5"
                                android:shadowRadius="2" />

                            <!-- Map data attribution watermark at bottom-right of map thumbnail -->
                            <TextView
                                android:id="@+id/liveMapDataWatermark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="4dp"
                                android:layout_marginBottom="3dp"
                                android:text="Map data ©2026"
                                android:textColor="#D9FFFFFF"
                                android:textSize="6sp"
                                android:shadowColor="#E6000000"
                                android:shadowDx="1.5"
                                android:shadowDy="1.5"
                                android:shadowRadius="2" />

                            <!-- Check In ribbon for Reporting Template -->
                            <TextView
                                android:id="@+id/liveCheckInRibbon"
                                android:layout_width="match_parent"
                                android:layout_height="16dp"
                                android:layout_gravity="top"
                                android:background="@drawable/template_check_in_badge"
                                android:text="Check In"
                                android:textColor="#FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:visibility="gone" />

                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Center Text Details: fills middle width with weight 1 -->
                    <LinearLayout
                        android:id="@+id/gpsOverlayTextContainer"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">

                        <!-- Bold city/state header with flag -->
                        <TextView
                            android:id="@+id/geo_city_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="1dp"
                            android:includeFontPadding="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="Location"/>

                        <!-- Street and area address (clean 2 lines maximum) -->
                        <TextView
                            android:id="@+id/geo_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="1dp"
                            android:includeFontPadding="false"
                            android:textColor="#E6FFFFFF"
                            android:textSize="11sp"
                            android:maxLines="2"
                            android:lineSpacingExtra="0dp"
                            android:ellipsize="end"
                            android:text="@string/address_placeholder"/>

                        <!-- Lat/Long on a single clean line -->
                        <TextView
                            android:id="@+id/geo_latlon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="1dp"
                            android:includeFontPadding="false"
                            android:textColor="#E6FFFFFF"
                            android:textSize="11sp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="Lat --°   Long --°"/>

                        <!-- Date and time on a single clean line -->
                        <TextView
                            android:id="@+id/geo_datetime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="0dp"
                            android:includeFontPadding="false"
                            android:textColor="#E6FFFFFF"
                            android:textSize="11sp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="@string/datetime_format"/>

                        <!-- Azimuth line for Compass Template -->
                        <TextView
                            android:id="@+id/liveAzimuthText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#E6FFFFFF"
                            android:textSize="10sp"
                            android:text="Azimuth/Bearing : 207.00°"
                            android:visibility="gone" />

                        <!-- Altitude and Magnetic Field for Compass Template -->
                        <TextView
                            android:id="@+id/liveTelemetryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#E6FFFFFF"
                            android:textSize="10sp"
                            android:text="⛰️ 15 m       🧲 71.25 µT"
                            android:visibility="gone" />

                        <!-- Mode & Camera Watermark (shifted right before the border of the bar code starts) -->
                        <TextView
                            android:id="@+id/liveModeWatermarkBeforeBarcode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="3dp"
                            android:includeFontPadding="false"
                            android:text="Portrait Mode • Rear Camera"
                            android:textColor="#B3FFFFFF"
                            android:textSize="9.5sp"
                            android:textStyle="italic"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- Mini Map for Navigation Compass Template (Enlarged to match Compass Dial) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/liveMiniMapThumbnailCard"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#212121"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/liveMiniMapThumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Mini Map" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- QR Code / Barcode Card (Pristine 78dp Square with 8dp rounded corners on Right Corner) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/liveQrCodeCard"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/white"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/liveQrCode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="3dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="QR Code" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Mode & Camera Watermark: Right bottom corner for other templates -->
                <TextView
                    android:id="@+id/liveModeWatermarkCorner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false"
                    android:text="Portrait Mode • Rear Camera"
                    android:textColor="#E6FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="italic"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ImageButton
        android:id="@+id/quickOptionsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="52dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_quick_options"
        android:background="@drawable/btn_round_black_border"
        android:contentDescription="Quick Options"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/gpsLookupButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="52dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_gps_lookup"
        android:background="@drawable/btn_scanner_gold_circle"
        android:contentDescription="GPS Photo Scanner"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/quickOptionsButton" />

    <ImageButton
        android:id="@+id/timelineButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="52dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_map_timeline"
        android:background="@drawable/btn_round_black_border"
        android:contentDescription="Map Timeline"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/gpsLookupButton" />

    <ImageButton
        android:id="@+id/templateButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="52dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_template_select"
        android:background="@drawable/btn_round_black_border"
        android:contentDescription="Templates"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/settingsButton" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="52dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_baseline_settings_24"
        android:background="@drawable/btn_round_black_border"
        android:contentDescription="@string/settings"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/countdownTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="120sp"
        android:textColor="#FFEB3B"
        android:textStyle="bold"
        android:visibility="gone"
        android:shadowColor="#000000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>