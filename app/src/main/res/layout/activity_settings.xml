<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Top AppBar and Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settingsToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1F3A60"
            app:title="@string/settings"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_back_white" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Visit Mode Settings -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/visit_mode"
                        android:textColor="#1F3A60"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/visit_mode_description"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/visitModeSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enable Visit Mode"
                        android:textColor="#222222"
                        android:textSize="16sp" />

                    <View
                        android:id="@+id/visitModeDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/signatureRequiredSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Signature Required"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Signature Settings -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/signatureSettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/signature_section_title"
                        android:textColor="#1F3A60"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/signature_description"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="16dp" />

                    <!-- Preview Frame representing the allocated signing space -->
                    <FrameLayout
                        android:id="@+id/signaturePreviewFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FAFAFA"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_marginBottom="16dp">

                        <!-- Inner container that matches the PDF content width exactly -->
                        <LinearLayout
                            android:id="@+id/signaturePreviewContentArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <!-- Top border representing last row of table -->
                            <LinearLayout
                                android:id="@+id/sigPreviewTableLine"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Last Line of Row of Table"
                                    android:textColor="#90A4AE"
                                    android:textSize="9sp"
                                    android:layout_marginBottom="2dp" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="#B0BEC5" />
                            </LinearLayout>

                            <!-- Container for the signature card to float in (dynamically sized) -->
                            <FrameLayout
                                android:id="@+id/sigPreviewFloatArea"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:clipChildren="false"
                                android:clipToPadding="false">

                                <!-- Card for visual boundary of signature area in PDF -->
                                <!-- Align to bottom-left default anchor -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/signaturePreviewBorderCard"
                                    android:layout_width="120dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="bottom|start"
                                    android:layout_marginBottom="2dp"
                                    app:cardCornerRadius="2dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="#1F3A60"
                                    app:strokeWidth="1dp"
                                    app:cardBackgroundColor="#22FFFFFF"
                                    android:visibility="gone"
                                    tools:visibility="visible">

                                    <ImageView
                                        android:id="@+id/signaturePreviewImage"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="2dp"
                                        android:scaleType="fitXY" />

                                </com.google.android.material.card.MaterialCardView>

                            </FrameLayout>

                            <!-- Bottom border representing Signature Official text -->
                            <LinearLayout
                                android:id="@+id/sigPreviewSignatureLine"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="start">

                                <View
                                    android:id="@+id/sigPreviewLineView"
                                    android:layout_width="160dp"
                                    android:layout_height="1dp"
                                    android:background="#B0BEC5"
                                    android:layout_marginTop="2dp" />

                                 <TextView
                                    android:id="@+id/sigPreviewLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Signature of Visiting Official"
                                    android:textColor="#90A4AE"
                                    android:textStyle="bold"
                                    android:textSize="9sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/noSignatureText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="@string/no_signature_hint"
                            android:textColor="#888888"
                            android:textSize="13sp" />

                    </FrameLayout>

                    <!-- Buttons Layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUploadSignature"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/upload_signature"
                            android:textSize="12sp"
                            android:backgroundTint="#1F3A60"
                            android:textColor="@color/white" />

                        <Space
                            android:id="@+id/btnEditSpace"
                            android:layout_width="8dp"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditSignature"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Edit"
                            android:textSize="12sp"
                            android:textColor="#1F3A60"
                            app:strokeColor="#1F3A60"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <Space
                            android:id="@+id/btnClearSpace"
                            android:layout_width="8dp"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearSignature"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Clear"
                            android:textSize="12sp"
                            android:textColor="#D32F2F"
                            app:strokeColor="#D32F2F"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>

                    <!-- Dynamic Signature Size settings -->
                    <LinearLayout
                        android:id="@+id/signatureSizeContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PDF Signature Sizing (Dynamic)"
                            android:textStyle="bold"
                            android:textColor="#1F3A60"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <!-- Width SeekBar -->
                        <TextView
                            android:id="@+id/sigWidthLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Display Width: 120pt"
                            android:textSize="12sp"
                            android:textColor="#555555"
                            android:layout_marginBottom="4dp" />

                        <SeekBar
                            android:id="@+id/sigWidthSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="300"
                            android:progress="120"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Height SeekBar -->
                        <TextView
                            android:id="@+id/sigHeightLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Display Height: 40pt"
                            android:textSize="12sp"
                            android:textColor="#555555"
                            android:layout_marginBottom="4dp" />

                        <SeekBar
                            android:id="@+id/sigHeightSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="150"
                            android:progress="40"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Horizontal Shift SeekBar -->
                        <TextView
                            android:id="@+id/sigOffsetXLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Horizontal Shift: 0pt"
                            android:textSize="12sp"
                            android:textColor="#555555"
                            android:layout_marginBottom="4dp" />

                        <SeekBar
                            android:id="@+id/sigOffsetXSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="500"
                            android:progress="250"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Vertical Shift SeekBar -->
                        <TextView
                            android:id="@+id/sigOffsetYLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Vertical Shift: 0pt"
                            android:textSize="12sp"
                            android:textColor="#555555"
                            android:layout_marginBottom="4dp" />

                        <SeekBar
                            android:id="@+id/sigOffsetYSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="120"
                            android:progress="60"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Rotation / Curve SeekBar -->
                        <TextView
                            android:id="@+id/sigRotationLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Curve/Slant Rotation: 0°"
                            android:textSize="12sp"
                            android:textColor="#555555"
                            android:layout_marginBottom="4dp" />

                        <SeekBar
                            android:id="@+id/sigRotationSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="90"
                            android:progress="45"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>