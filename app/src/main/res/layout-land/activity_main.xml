<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootContainer"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="@android:color/transparent"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/gallery_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_gallery"
            app:tint="@android:color/white"
            android:contentDescription="@string/gallery" />

        <ImageButton
            android:id="@+id/prepare_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_prepare_report"
            app:tint="@android:color/white"
            android:contentDescription="@string/prepare_report" />

        <ImageButton
            android:id="@+id/camera_capture_button"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:src="@drawable/capture_button_bg"
            app:tint="@android:color/white"
            android:contentDescription="@string/capture_photo" />

        <ImageButton
            android:id="@+id/video_record_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/presence_video_online"
            app:tint="@android:color/white"
            android:contentDescription="@string/record_video" />

        <ImageButton
            android:id="@+id/collage_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_collage"
            app:tint="@android:color/white"
            android:contentDescription="@string/collage" />

        <ImageButton
            android:id="@+id/switch_camera_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_camera_switch"
            android:contentDescription="@string/switch_camera" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/gpsOverlayWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:layout_marginStart="@dimen/gps_overlay_landscape_side_margin"
        android:layout_marginEnd="@dimen/gps_overlay_landscape_side_margin"
        android:layout_marginBottom="@dimen/gps_overlay_landscape_vertical_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonLayout">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/gpsOverlayCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:elevation="16dp"
            android:translationZ="16dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:backgroundTint="#99000000">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <FrameLayout
                    android:id="@+id/liveMapThumbnailContainer"
                    android:layout_width="0dp"
                    android:layout_weight="0.8"
                    android:layout_height="match_parent"
                    android:minHeight="120dp">

                    <ImageView
                        android:id="@+id/liveMapThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/live_map_thumbnail"
                        android:background="@drawable/rounded_corners"
                        android:clickable="true"
                        android:focusable="true"/>

                </FrameLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1.2"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp">

                    <!-- Badge overlay above the text details (next to the map) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="4dp"
                        app:cardCornerRadius="3dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#CC000000">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ad Free GPS Cam Visit Pro"
                            android:textColor="#FFFFFF"
                            android:textSize="7sp"
                            android:textStyle="bold"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/TextAppearance.App.GpsOverlayTitle"
                        android:id="@+id/geo_lat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/latitude_placeholder"/>

                    <TextView
                        style="@style/TextAppearance.App.GpsOverlayTitle"
                        android:id="@+id/geo_lon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/longitude_placeholder"/>

                    <TextView
                        style="@style/TextAppearance.App.GpsOverlayValue"
                        android:id="@+id/geo_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:maxLines="4"
                        android:lineSpacingExtra="2dp"
                        android:breakStrategy="balanced"
                        android:singleLine="false"
                        android:text="@string/address_placeholder"/>

                    <TextView
                        style="@style/TextAppearance.App.GpsOverlayValue"
                        android:id="@+id/geo_datetime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/datetime_format"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_baseline_settings_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
