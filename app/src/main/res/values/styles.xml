<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.GpsOverlayTitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15.5sp</item>
    </style>
    <style name="TextAppearance.App.GpsOverlayValue" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="CircleShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedMapCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="TopDialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
